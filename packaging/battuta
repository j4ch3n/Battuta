#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$root/bin:$root/artifact-service/.venv/bin:$PATH"

load_memory_environment() {
  if [[ -f "$root/.env.prod" ]]; then
    set -a
    source "$root/.env.prod"
    set +a
  fi
}

case "${1:-}" in
  setup-artifacts)
    shift
    exec bash "$root/scripts/setup-artifacts.sh" "$@"
    ;;
  artifacts|artifact)
    command="$1"
    shift
    [[ -x "$root/artifact-service/.venv/bin/battuta-artifact" ]] || { printf 'Run bin/battuta setup-artifacts first\n' >&2; exit 1; }
    if [[ "$command" == artifacts ]]; then
      exec "$root/artifact-service/.venv/bin/battuta-artifact" serve "$@"
    fi
    exec "$root/artifact-service/.venv/bin/battuta-artifact" "$@"
    ;;
  setup-memory)
    shift
    load_memory_environment
    exec bash "$root/scripts/setup-memory.sh" "$@"
    ;;
  memory)
    load_memory_environment
    [[ -x "$root/memory-service/.venv/bin/battuta-memory" ]] || { printf 'Run bin/battuta setup-memory first\n' >&2; exit 1; }
    exec "$root/memory-service/.venv/bin/battuta-memory" serve
    ;;
  configure)
    [[ -f "$root/.env.prod" ]] || { printf 'Copy %s/.env.example to %s/.env.prod and fill it in first\n' "$root" "$root" >&2; exit 1; }
    set -a
    source "$root/.env.prod"
    set +a
    exec "$root/bin/node" "$root/bin/configure.mjs"
    ;;
  start-prod-screen)
    exec bash "$root/bots/pm-bot/scripts/run-dev.sh" prod
    ;;
  pm|tl)
    role="$1"
    bot_dir="$root/bots/$role-bot"
    [[ -f "$root/.env.prod" ]] || { printf 'Missing %s/.env.prod\n' "$root" >&2; exit 1; }
    [[ -x "$bot_dir/node_modules/.bin/pi" && -f "$bot_dir/AGENTS.md" && -f "$bot_dir/.pi/telegram.json" && -f "$bot_dir/.pi/mcp.json" ]] || {
      printf 'Configure %s first with bin/battuta configure\n' "$role" >&2
      exit 1
    }
    [[ -d "$root/agent-mail/node_modules" ]] || { printf 'Missing agent-mail dependencies\n' >&2; exit 1; }
    [[ -d "$root/project-spec/node_modules" ]] || { printf 'Missing project-spec dependencies\n' >&2; exit 1; }
    [[ -d "$root/memory-client/node_modules" ]] || { printf 'Missing memory client dependencies\n' >&2; exit 1; }
    set -a
    source "$root/.env.prod"
    set +a
    for key in LINEAR_API_TOKEN SUPABASE_URL SUPABASE_SECRET_KEY; do
      [[ -n "${!key:-}" ]] || { printf 'Set %s in .env.prod\n' "$key" >&2; exit 1; }
    done
    export AGENT_ROLE="$role" PI_CODING_AGENT_DIR="$bot_dir/.pi"
    export BATTUTA_MEMORY_URL="${BATTUTA_MEMORY_URL:-http://127.0.0.1:8901/mcp}"
    if [[ "$role" == pm ]]; then
      export PI_SCHEDULER_STATE_FILE
      PI_SCHEDULER_STATE_FILE="$("$root/bin/node" "$root/memory-client/configure-scheduler.mjs" --print-path)"
      export PI_SCHEDULER_CATCHUP_MAX
      PI_SCHEDULER_CATCHUP_MAX="$("$root/bin/node" "$root/memory-client/configure-scheduler.mjs" --print-catchup)"
      "$root/bin/node" "$root/memory-client/configure-scheduler.mjs" --check
    fi
    cd "$bot_dir"
    exec "$bot_dir/node_modules/.bin/pi" --approve --continue --session-dir "$bot_dir/.pi/mail-sessions" --extension "$root/agent-mail/index.ts" --extension "$root/project-spec/index.ts" --extension "$root/memory-client/index.ts"
    ;;
  install-services)
    exec "$root/bin/node" "$root/bin/install-services.mjs"
    ;;
  *)
    printf 'Usage: %s configure|setup-memory|memory|setup-artifacts|artifacts|artifact|start-prod-screen|pm|tl|install-services\n' "$0" >&2
    exit 2
    ;;
esac
