#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$root/bin:$PATH"

case "${1:-}" in
  configure)
    [[ -f "$root/.env.prod" ]] || { printf 'Copy %s/.env.example to %s/.env.prod and fill it in first\n' "$root" "$root" >&2; exit 1; }
    set -a
    source "$root/.env.prod"
    set +a
    exec "$root/bin/node" "$root/bin/configure.mjs"
    ;;
  start-prod-screen)
    exec bash "$root/bots/pm-bot/scripts/run-dev.sh" prod
    ;;
  pm|tl)
    role="$1"
    bot_dir="$root/bots/$role-bot"
    [[ -f "$root/.env.prod" ]] || { printf 'Missing %s/.env.prod\n' "$root" >&2; exit 1; }
    [[ -x "$bot_dir/node_modules/.bin/pi" && -f "$bot_dir/AGENTS.md" && -f "$bot_dir/.pi/telegram.json" && -f "$bot_dir/.pi/mcp.json" ]] || {
      printf 'Configure %s first with bin/battuta configure\n' "$role" >&2
      exit 1
    }
    [[ -d "$root/agent-mail/node_modules" ]] || { printf 'Missing agent-mail dependencies\n' >&2; exit 1; }
    [[ -d "$root/project-spec/node_modules" ]] || { printf 'Missing project-spec dependencies\n' >&2; exit 1; }
    [[ -d "$root/memory-stone/node_modules" ]] || { printf 'Missing memory bridge dependencies\n' >&2; exit 1; }
    set -a
    source "$root/.env.prod"
    set +a
    for key in LINEAR_API_TOKEN SUPABASE_URL SUPABASE_SECRET_KEY; do
      [[ -n "${!key:-}" ]] || { printf 'Set %s in .env.prod\n' "$key" >&2; exit 1; }
    done
    export AGENT_ROLE="$role" PI_CODING_AGENT_DIR="$bot_dir/.pi"
    export PI_MEMORY_STONE_DB_PATH="${PI_MEMORY_STONE_DB_PATH:-$HOME/.battuta/memory/memory.db}"
    [[ "$PI_MEMORY_STONE_DB_PATH" = /* ]] || { printf 'PI_MEMORY_STONE_DB_PATH must be an absolute shared path\n' >&2; exit 1; }
    cd "$bot_dir"
    exec "$bot_dir/node_modules/.bin/pi" --approve --continue --session-dir "$bot_dir/.pi/mail-sessions" --extension "$root/agent-mail/index.ts" --extension "$root/project-spec/index.ts" --extension "$root/memory-stone/index.ts"
    ;;
  install-services)
    exec "$root/bin/node" "$root/bin/install-services.mjs"
    ;;
  *)
    printf 'Usage: %s configure|start-prod-screen|pm|tl|install-services\n' "$0" >&2
    exit 2
    ;;
esac
