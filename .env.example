# CoS bot
COS_TELEGRAM_TOKEN=
COS_TELEGRAM_BOT_USERNAME=

# CoS only; Manager has no Telegram integration.
TELEGRAM_ALLOWED_USER_ID=
# Shared by both bots
LINEAR_API_TOKEN=

# Supabase project origin and server-side secret key. Use loopback for local development;
# use the intended remote project for production.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Public base URL printed for registered artifacts. The artifact service itself stays on localhost.
BATTUTA_ARTIFACT_BASE_URL=
# Launchers set AGENT_ROLE=cos, manager, or worker for each Pi process.
# Shared local memory MCP (same endpoint for both bots; no provider keys needed here)
BATTUTA_MEMORY_URL=http://127.0.0.1:8901/mcp
# Required for CoS dream setup: provider/model-id. No default or conversation-model fallback.
BATTUTA_DREAM_MODEL=
# Optional absolute data override; model cache still follows the service user's HOME.
# BATTUTA_MEMORY_DATA_DIR=/absolute/path/to/memory-service

# Optional: required when gog uses the encrypted file keyring.
# Must match the password protecting the existing keyring.
GOG_KEYRING_PASSWORD=

# Select each worker's manifest type. Remove numbered entries to disable workers.
BATTUTA_WORKER_1_TYPE=general

# Model per difficulty, as provider/model-id. Each bot's bot.toml picks a tier and
# every launch uses it, so edit here, not in settings.json. Unset or empty falls
# back to Pi's own default model. Workers also pick the tier per assignment.
MODEL_FOR_EASY_TASKS=
MODEL_FOR_MEDIUM_TASKS=
MODEL_FOR_HARD_TASKS=
MODEL_FOR_HAIL_MARY_TASKS=
