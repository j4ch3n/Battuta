# PM bot
PM_TELEGRAM_TOKEN=
PM_TELEGRAM_BOT_USERNAME=

# Optional: required when gog uses the encrypted file keyring.
# Must match the password protecting the existing keyring.
GOG_KEYRING_PASSWORD=

# TL bot
TL_TELEGRAM_TOKEN=
TL_TELEGRAM_BOT_USERNAME=

# Shared by both bots
TELEGRAM_ALLOWED_USER_ID=
LINEAR_API_TOKEN=

# Local Supabase API URL and server-side secret key (supabase status -o env).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Launchers set AGENT_ROLE=pm or tl for each Pi process.

# Dedicated Supabase Auth machine accounts (server-controlled app_metadata.battuta).
# Delegation authenticates lazily; missing task keys do not block unrelated bot use.
SUPABASE_PUBLISHABLE_KEY=
PM_TASK_EMAIL=
PM_TASK_PASSWORD=
TL_TASK_EMAIL=
TL_TASK_PASSWORD=

# Worker-only host: keep only URL, publishable key and these two values in its
# private environment. No Telegram, Linear, service-role/admin or bot mail key.
WORKER_TASK_EMAIL=
WORKER_TASK_PASSWORD=
