# CoS bot
COS_TELEGRAM_TOKEN=
COS_TELEGRAM_BOT_USERNAME=

# CoS only; Manager has no Telegram integration.
TELEGRAM_ALLOWED_USER_ID=
# Shared by both bots
LINEAR_API_TOKEN=

# Supabase project origin and server-side secret key. Use loopback for local development;
# use the intended remote project for production.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Public base URL printed for registered artifacts. The artifact service itself stays on localhost.
BATTUTA_ARTIFACT_BASE_URL=
# Launchers set AGENT_ROLE=cos, manager, or worker for each Pi process.

# Local memory service. CoS uses this URL; Manager and battuta-project use <URL>/read.
BATTUTA_MEMORY_URL=http://127.0.0.1:8901/mcp
# Optional absolute data override (default ~/.battuta/memory).
# The pinned Qwen3 embedding model lives under ~/.cache/battuta/models/ for the service user.
# BATTUTA_MEMORY_DATA_DIR=/absolute/path/to/memory
# The nightly dream runs Claude Code as the service user; `claude` must be installed and signed in.
# Optional Claude Code model for the dream (default claude-haiku-5-5).
# BATTUTA_MEMORY_DREAM_MODEL=claude-haiku-5-5

# Optional: required when gog uses the encrypted file keyring.
# Must match the password protecting the existing keyring.
GOG_KEYRING_PASSWORD=

# Select each worker's manifest type. Remove numbered entries to disable workers.
BATTUTA_WORKER_1_TYPE=general

# Claude Code models a worker may delegate to, as provider/model-id (anthropic/ only).
# economy = EASY, balanced = MEDIUM, max = HARD. Hail-mary work also delegates at max,
# so MODEL_FOR_HAIL_MARY_TASKS is unused. Each bot's own Pi model is set in its
# bot.toml [defaults] model, not here. An unset value leaves that tier unavailable.
MODEL_FOR_EASY_TASKS=
MODEL_FOR_MEDIUM_TASKS=
MODEL_FOR_HARD_TASKS=
MODEL_FOR_HAIL_MARY_TASKS=
