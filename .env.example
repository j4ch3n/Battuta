# PM bot
PM_TELEGRAM_TOKEN=
PM_TELEGRAM_BOT_USERNAME=

# Optional: required when gog uses the encrypted file keyring.
# Must match the password protecting the existing keyring.
GOG_KEYRING_PASSWORD=

# TL bot
TL_TELEGRAM_TOKEN=
TL_TELEGRAM_BOT_USERNAME=

# Shared by both bots
TELEGRAM_ALLOWED_USER_ID=
LINEAR_API_TOKEN=

# Local Supabase API URL and server-side secret key (supabase status -o env).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Launchers set AGENT_ROLE=pm or tl for each Pi process.
# Shared local memory MCP (same endpoint for both bots; no provider keys needed here)
BATTUTA_MEMORY_URL=http://127.0.0.1:8901/mcp
# Optional absolute data override; model cache still follows the service user's HOME.
# BATTUTA_MEMORY_DATA_DIR=/absolute/path/to/memory-service
