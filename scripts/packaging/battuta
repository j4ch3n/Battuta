#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$root/bin:$PATH"

require_tool() {
  command -v "$1" >/dev/null || { printf 'Missing %s; use uv tool install as described in RELEASE.md and add the tool directory to PATH\n' "$1" >&2; exit 1; }
}

load_memory_environment() {
  if [[ -f "$root/.env.prod" ]]; then
    set -a
    source "$root/.env.prod"
    set +a
  fi
}

case "${1:-}" in
  configure-worker)
    shift
    [[ -f "$root/.env.prod" ]] || { printf 'Missing release environment file\n' >&2; exit 1; }
    require_tool battuta-bot-setup
    exec battuta-bot-setup configure-worker --root "$root" "$@"
    ;;
  worker)
    shift
    exec bash "$root/scripts/bot_setup/run-worker.sh" --env-file "$root/.env.prod" "$@"
    ;;
  setup-artifacts)
    shift
    exec bash "$root/scripts/setup-artifacts.sh" "$@"
    ;;
  artifacts|artifact)
    command="$1"
    shift
    require_tool battuta-artifact
    if [[ "$command" == artifacts ]]; then
      exec battuta-artifact serve "$@"
    fi
    exec battuta-artifact "$@"
    ;;
  setup-memory)
    shift
    load_memory_environment
    exec bash "$root/scripts/setup-memory.sh" "$@"
    ;;
  memory)
    load_memory_environment
    require_tool battuta-memory
    exec battuta-memory serve
    ;;
  configure)
    shift
    [[ -f "$root/.env.prod" ]] || { printf 'Copy %s/.env.example to %s/.env.prod and fill it in first\n' "$root" "$root" >&2; exit 1; }
    set -a
    source "$root/.env.prod"
    set +a
    require_tool battuta-bot-setup
    exec battuta-bot-setup configure-release --root "$root" "$@"
    ;;
  start-prod-screen)
    exec bash "$root/scripts/bot_setup/run-dev.sh" prod
    ;;
  cos|manager)
    role="$1"
    bot_dir="$root/bots/$role-bot"
    [[ -f "$root/.env.prod" ]] || { printf 'Missing %s/.env.prod\n' "$root" >&2; exit 1; }
    [[ -x "$bot_dir/node_modules/.bin/pi" && -f "$bot_dir/AGENTS.md" && -f "$bot_dir/.pi/mcp.json" ]] || {
      printf 'Configure %s first with bin/battuta configure\n' "$role" >&2
      exit 1
    }
    if [[ "$role" == cos && ! -f "$bot_dir/.pi/telegram.json" ]]; then
      printf 'Configure CoS Telegram first with bin/battuta configure\n' >&2
      exit 1
    fi
    [[ -d "$root/agent-mail/node_modules" ]] || { printf 'Missing agent-mail dependencies\n' >&2; exit 1; }
    [[ -d "$root/project-spec/node_modules" ]] || { printf 'Missing project-spec dependencies\n' >&2; exit 1; }
    [[ -d "$root/memory-client/node_modules" ]] || { printf 'Missing memory client dependencies\n' >&2; exit 1; }
    set -a
    source "$root/.env.prod"
    set +a
    for key in LINEAR_API_TOKEN SUPABASE_URL SUPABASE_SECRET_KEY; do
      [[ -n "${!key:-}" ]] || { printf 'Set %s in .env.prod\n' "$key" >&2; exit 1; }
    done
    export AGENT_ROLE="$role" PI_CODING_AGENT_DIR="$bot_dir/.pi"
    export BATTUTA_MEMORY_URL="${BATTUTA_MEMORY_URL:-http://127.0.0.1:8901/mcp}"
    if [[ "$role" == cos ]]; then
      umask 077
      export PI_SCHEDULER_STATE_FILE
      PI_SCHEDULER_STATE_FILE="$("$root/bin/node" "$root/memory-client/configure-scheduler.mjs" --print-path)"
      export PI_SCHEDULER_CATCHUP_MAX
      PI_SCHEDULER_CATCHUP_MAX="$("$root/bin/node" "$root/memory-client/configure-scheduler.mjs" --print-catchup)"
      "$root/bin/node" "$root/memory-client/configure-scheduler.mjs" --check
    else
      for key in $(compgen -v); do
        case "$key" in *TELEGRAM*) unset "$key";; esac
      done
      unset PI_SCHEDULER_STATE_FILE PI_SCHEDULER_CATCHUP_MAX
    fi
    cd "$bot_dir"
    extensions=(--extension "$root/agent-mail/index.ts" --extension "$root/project-spec/index.ts")
    if [[ "$role" == cos ]]; then extensions+=(--extension "$root/memory-client/index.ts"); fi
    exec "$bot_dir/node_modules/.bin/pi" --approve --continue --session-dir "$bot_dir/.pi/mail-sessions" "${extensions[@]}"
    ;;
  install-services)
    shift
    require_tool battuta-packaging
    exec battuta-packaging install-services --root "$root" "$@"
    ;;
  *)
    printf 'Usage: %s configure|configure-worker|worker|setup-memory|memory|setup-artifacts|artifacts|artifact|start-prod-screen|cos|manager|install-services\n' "$0" >&2
    exit 2
    ;;
esac
